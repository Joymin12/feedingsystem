# AI 설명 기능 (구글 Gemini)
#
# 키 발급: https://aistudio.google.com → Get API key → Create API key
# 이 파일을 .env 로 복사한 뒤 실제 키를 넣으세요. .env 는 git에 올라가지 않습니다.
#
# 키가 비어 있으면 /v1/explanations 가 503을 반환하고,
# 앱은 내장 설명 문구로 자동 폴백합니다. (개발 중에는 비워 두어도 됩니다.)
GEMINI_API_KEY=
# gemini-2.5-flash 같은 고정 버전 이름은 신규 프로젝트에서 404가 날 수 있습니다.
GEMINI_MODEL=gemini-flash-latest

PORT=3001
