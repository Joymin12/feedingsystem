{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "jsx": "preserve",
    "incremental": true,
    "noEmit": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@hanwoo-tmr/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@hanwoo-tmr/contracts/*": [
        "../../packages/contracts/src/*"
      ],
      "@hanwoo-tmr/domain": [
        "../../packages/domain/src/index.ts"
      ],
      "@hanwoo-tmr/domain/*": [
        "../../packages/domain/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
